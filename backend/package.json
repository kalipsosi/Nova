{
  "name": "nova-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "bot": "tsx src/bot.ts",
    "start:bot": "node dist/bot.js",
    "build": "tsc",
    "migrate": "tsx src/migrate.ts",
    "test": "tsx --test test/unit/**/*.test.ts test/acceptance.test.ts",
    "test:unit": "tsx --test test/unit/**/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
