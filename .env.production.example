# Общие настройки. Для systemd оставьте BOT_ENABLED=false: бот запускается отдельно.
NODE_ENV=production
BOT_ENABLED=false
PORT=3000
BIND_HOST=127.0.0.1
DATABASE_URL=postgres://nova:replace-with-postgres-password@127.0.0.1:5432/nova
WEBAPP_URL=https://nova.example.com
ALLOWED_ORIGINS=https://nova.example.com
BOT_TOKEN=replace-with-botfather-token
BOT_USERNAME=your_bot
DEV_AUTH_BYPASS=false
INITDATA_MAX_AGE_SECONDS=86400
SESSION_TTL_HOURS=720
INVITE_TTL_HOURS=72

# Только для необязательного запуска через Docker Compose:
POSTGRES_USER=nova
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_DB=nova
NOVA_DOMAIN=nova.example.com
TIPS_HOUR=10
TIPS_TIMEZONE=Europe/Moscow
