[Unit]
Description=Nova Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nova
Group=nova
WorkingDirectory=/var/www/nova/backend
EnvironmentFile=/etc/nova/nova.env
Environment=BOT_ENABLED=true
ExecStart=/usr/bin/node /var/www/nova/backend/dist/bot.js
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/nova

[Install]
WantedBy=multi-user.target
