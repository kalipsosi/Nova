# Скопируйте в .env. Реальные секреты не коммитьте.
NODE_ENV=development
PORT=3000
BIND_HOST=127.0.0.1

# PostgreSQL слушает localhost в native-режиме. Не публикуйте его в интернет.
DATABASE_URL=postgres://nova:nova@127.0.0.1:5432/nova

# Токен от @BotFather. В development API может стартовать без него.
BOT_TOKEN=
BOT_USERNAME=
# BOT_ENABLED=true запускает long polling в том же процессе, что и API.
# Не включайте одновременно с отдельным процессом nova-bot.
BOT_ENABLED=false

# HTTPS-адрес Mini App. Локально — адрес Vite.
WEBAPP_URL=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Локальный вход без Telegram. Работает только при NODE_ENV=development или test
# и только если BIND_HOST — loopback. В production процесс не запустится.
DEV_AUTH_BYPASS=true

INITDATA_MAX_AGE_SECONDS=86400
SESSION_TTL_HOURS=720
INVITE_TTL_HOURS=72

# Отдельный секрет для скриптов резервного копирования. API его не читает.
BACKUP_PASSPHRASE=change-me-to-a-long-passphrase
